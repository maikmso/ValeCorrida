<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HERO (topo azul-marinho) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="26dp"
                android:paddingEnd="22dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vale a Corrida"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtStatusGeral"
                        style="@style/Chip"
                        android:text="● Desligado" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_badge_hero"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="Para motoristas de Uber e 99"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingMultiplier="0.95"
                    android:text="Saiba na hora se"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="a corrida "
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="compensa."
                        android:textColor="@color/amarelo"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Um balão aparece em cima da oferta com R$/km, R$/hora e o lucro depois do combustível."
                    android:textColor="#CBD5E1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnTestar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_amarelo"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="⚡  Testar o balão agora  →"
                    android:textColor="@color/ambar"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Onda no fim do topo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/onda" />
        </LinearLayout>

        <!-- ===== CONTEÚDO ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <!-- ATUALIZAÇÃO (aparece só quando tem versão nova) -->
            <LinearLayout
                android:id="@+id/cardAtualizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_update"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtAtualizacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎉 Nova versão disponível"
                    android:textColor="@color/texto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Toque para baixar e instalar. Suas configurações continuam salvas."
                    android:textColor="@color/texto2"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnAtualizar"
                    style="@style/BotaoPrimario"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Atualizar agora  →"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- PERMISSÕES -->
            <TextView
                style="@style/Secao"
                android:layout_marginTop="6dp"
                android:text="Permissões" />

            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:id="@+id/rowSobreposicao"
                    style="@style/Linha">

                    <TextView
                        style="@style/Icone"
                        android:text="🪟" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TituloLinha"
                            android:text="Sobreposição" />

                        <TextView
                            style="@style/SubLinha"
                            android:text="Mostrar o balão por cima do Uber e da 99" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtSobreposicao"
                        style="@style/Chip"
                        android:text="Ativar" />
                </LinearLayout>

                <View style="@style/Divisor" />

                <LinearLayout
                    android:id="@+id/rowAcessibilidade"
                    style="@style/Linha">

                    <TextView
                        style="@style/Icone"
                        android:text="👁" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TituloLinha"
                            android:text="Leitura de tela" />

                        <TextView
                            style="@style/SubLinha"
                            android:text="Ler valor, distância e tempo da oferta" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtAcessibilidade"
                        style="@style/Chip"
                        android:text="Ativar" />
                </LinearLayout>

                <View style="@style/Divisor" />

                <LinearLayout
                    android:id="@+id/rowInfoApp"
                    style="@style/Linha">

                    <TextView
                        style="@style/Icone"
                        android:text="🔋" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TituloLinha"
                            android:text="Bateria e restrições" />

                        <TextView
                            style="@style/SubLinha"
                            android:text="Deixe a bateria “Sem restrições”. Chave cinza? ⋮ → Permitir configurações restritas" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/texto3"
                        android:textSize="26sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARRO -->
            <TextView
                style="@style/Secao"
                android:text="Seu carro" />

            <LinearLayout
                style="@style/Card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Campo"
                        android:layout_marginEnd="6dp">

                        <TextView
                            style="@style/Rotulo"
                            android:text="⛽ Combustível (R$/L)" />

                        <EditText
                            android:id="@+id/edtPrecoLitro"
                            style="@style/Input" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Campo"
                        android:layout_marginStart="6dp">

                        <TextView
                            style="@style/Rotulo"
                            android:text="🚗 Consumo (km/L)" />

                        <EditText
                            android:id="@+id/edtKmPorLitro"
                            style="@style/Input" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- METAS -->
            <TextView
                style="@style/Secao"
                android:text="Suas metas" />

            <LinearLayout
                style="@style/Card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Campo"
                        android:layout_marginEnd="6dp">

                        <TextView
                            style="@style/Rotulo"
                            android:text="Mínimo por km (R$)" />

                        <EditText
                            android:id="@+id/edtMetaKm"
                            style="@style/Input" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Campo"
                        android:layout_marginStart="6dp">

                        <TextView
                            style="@style/Rotulo"
                            android:text="Mínimo por hora (R$)" />

                        <EditText
                            android:id="@+id/edtMetaHora"
                            style="@style/Input" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Campo"
                        android:layout_marginEnd="6dp">

                        <TextView
                            style="@style/Rotulo"
                            android:text="Balão na tela (seg)" />

                        <EditText
                            android:id="@+id/edtSegundos"
                            style="@style/Input"
                            android:digits="0123456789"
                            android:inputType="number" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:paddingTop="22dp"
                        android:text="🟢 bateu as 2 metas\n🟡 bateu 1 meta\n🔴 não bateu nenhuma"
                        android:textColor="@color/texto2"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- SALVAR -->
            <TextView
                android:id="@+id/btnSalvar"
                style="@style/BotaoPrimario"
                android:layout_marginTop="22dp"
                android:text="Salvar configurações  →" />

            <!-- DIAGNÓSTICO (escondido) -->
            <TextView
                android:id="@+id/txtToggleDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_ripple"
                android:gravity="center"
                android:padding="10dp"
                android:text="Diagnóstico ▾"
                android:textColor="@color/texto3"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutDiagnostico"
                style="@style/Card"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Rotulo"
                    android:text="Apps monitorados (pacotes, separados por vírgula)" />

                <EditText
                    android:id="@+id/edtPacotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:padding="12dp"
                    android:textColor="@color/texto"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtUltimoApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/texto2"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtUltimoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_diag"
                    android:fontFamily="monospace"
                    android:maxLines="14"
                    android:padding="10dp"
                    android:textColor="@color/texto2"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnCopiar"
                    style="@style/BotaoSecundario"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="Copiar texto lido"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="O app só lê a oferta e mostra o cálculo.\nEle não aceita nem recusa corridas."
                android:textColor="@color/texto3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtVersao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/texto3"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
